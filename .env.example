# Copy to .env locally. Never commit real secrets.
# Generate each independently: openssl rand -hex 32
DB_NAME=credicasa_db
DB_USER=credicasa
DB_PASSWORD=
JWT_SECRET=
# Generate once: openssl rand -base64 32. Preserve securely across restarts.
TWO_FACTOR_ENCRYPTION_KEY=
BACKEND_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
