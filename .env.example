# Copie a .env para sobrescribir los valores locales de docker-compose.yml. Nunca suba secretos reales.
# Genere cada secreto de forma independiente: openssl rand -hex 32
JWT_SECRET=
INTERNAL_API_TOKEN=
# openssl rand -base64 32 (consérvelo: cifra los secretos TOTP)
TWO_FACTOR_ENCRYPTION_KEY=
PAYMENT_SANDBOX_SECRET=
POSTGRES_PASSWORD=
RABBITMQ_USERNAME=credicasa
RABBITMQ_PASSWORD=
GATEWAY_PORT=8080
FRONTEND_PORT=80
POSTGRES_PORT=5433
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:[*],http://127.0.0.1:[*]
AUTH_RATE_LIMIT_PER_MINUTE=120
# Solo para pruebas E2E locales (vacío = endpoint de fixture deshabilitado)
E2E_FIXTURE_TOKEN=
FRONTEND_CONTEXT=../upc-pre-202620-1ASI0657-15987-FidiaCorp-FrontEnd
