  "item": [
    {
      "name": "V01 - Anonymous blocked on GET /simulations (401)",
      "request": { "method": "GET", "url": "{{baseUrl}}/simulations" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('V01 Anonymous -> 401', () => pm.response.to.have.status(401));"] } }]
    },
    {
      "name": "V02 - Forged JWT signature rejected (401)",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhdHRhY2tlciJ9.invalid-sig" }], "url": "{{baseUrl}}/simulations" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('V02 Forged JWT -> 401', () => pm.response.to.have.status(401));"] } }]
    },
    {
