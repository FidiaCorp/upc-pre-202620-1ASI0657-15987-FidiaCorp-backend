{
  "info": {
    "name": "CrediCasa QA-03 Adversarial Security Suite (OWASP API1/API2/API5 - 20 Vectors)",
    "description": "Colección automatizada de 20 vectores adversariales (BOLA/IDOR, BFLA, JWT lifecycle, revocación y aislamiento de API interna) contra API Gateway :8080 y microservicios CrediCasa.",
